name: Limpiar artefactos
on:
  workflow_dispatch: {}

permissions:
  actions: write
  contents: read

jobs:
  limpiar:
    runs-on: ubuntu-latest
    steps:
      - name: Borrar todos los artefactos del repositorio
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          ids=$(gh api --paginate "repos/${{ github.repository }}/actions/artifacts?per_page=100" --jq '.artifacts[].id')
          n=0
          for id in $ids; do
            if gh api -X DELETE "repos/${{ github.repository }}/actions/artifacts/$id" >/dev/null; then n=$((n+1)); fi
          done
          echo "Artefactos borrados: $n"
